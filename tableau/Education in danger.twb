        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;firearm&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;bullet&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;sniper&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;rifle&quot;) THEN 1 ELSE 0 END' />

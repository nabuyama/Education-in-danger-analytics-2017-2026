      <column caption='_weapon: artillery &amp; launched munitions' datatype='integer' name='[_weapon: aerial attacks (copy)_0289450254893062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;shelling&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;artillery&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;mortar&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;rocket&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;cluster&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_weapon: fire &amp; incendiar' datatype='integer' name='[_weapon: firearms (copy)_0289450258133001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (CONTAINS(LOWER([Weapon Carried/Used]), &quot;arson&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;fire&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;incendiary&quot;)) AND NOT CONTAINS(LOWER([Weapon Carried/Used]), &quot;firearm&quot;) THEN 1 ELSE 0 END' />

      <column caption='_selected period filter' datatype='datetime' name='[Calculation_0289450201845760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [Date])&#13;&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;, [Date])&#13;&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [Date])&#13;&#10;End' />
      </column>
      <column aggregation='Attribute' caption='_dynamic average per period' datatype='real' name='[Calculation_0289450205822977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Calculation_0289450201845760] : AVG({INCLUDE [Calculation_0289450201845760] : COUNT([SiND Event ID])})}' />
      </column>
      <column caption='_weapons list cleaned' datatype='string' name='[Calculation_0289450253074436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(REPLACE([Weapon Carried/Used], &quot; and &quot;, &quot;, &quot;))' />
      </column>
      <column caption='_weapon: aerial bombs, missiles' datatype='integer' name='[Calculation_0289450254557189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;drone&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;plane&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;aerial&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;missile&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_weapon: Melee &amp; Improvised Weapons' datatype='integer' name='[Calculation_0289450258464778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;knife&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;fist&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;stone&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;stick&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;blunt&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;gravel&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_weapon:chemical irritants' datatype='integer' name='[Calculation_0289450258608139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;chemical&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;liquid&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_weapon: other' datatype='integer' name='[Calculation_0289450259927052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;other weapon&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_weapon: no info' datatype='integer' name='[Calculation_0289450260348941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;no information&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;not applicable&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_weapon: tasers&amp; rubber bullets' datatype='integer' name='[Calculation_0289450260725774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Weapon Carried/Used]), &quot;taser&quot;) OR CONTAINS(LOWER([Weapon Carried/Used]), &quot;rubber&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='_stop highlighting' datatype='string' name='[Calculation_0652564314882048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;stop&apos;' />
      </column>
      <column caption='_educators&amp; students kidnapped?' datatype='boolean' name='[Calculation_1298527669460992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Educators Kidnapped] &gt; 0 OR [Students Kidnapped] &gt; 0' />
      </column>
      <column caption='_toll: student killings (left)' datatype='integer' name='[Calculation_2380721636200450]' role='measure' type='quantitative'>
